/**
 * @file Variable.def
 *
 * (Name -> Function) registry for variables
 */

// VCS Module

VARIABLE(vcs, remote_icon, VcsModule::remote_icon)
VARIABLE(vcs, branch,      VcsModule::branch)
VARIABLE(vcs, state,       VcsModule::state)
VARIABLE(vcs, wt_icon,     VcsModule::wt_icon)
VARIABLE(vcs, status,      VcsModule::status)
VARIABLE(vcs, divergence,  VcsModule::divergence)

// VENV Module

VARIABLE(venv, name, VenvModule::name)

// SYSTEM Module

VARIABLE(sys, user,      SysModule::user)
VARIABLE(sys, host,      SysModule::host)
VARIABLE(sys, sudo_icon, SysModule::sudo_icon)

// PATH Module

VARIABLE(path, path, PathModule::path)

// OS Module

VARIABLE(os, distro_icon, OsModule::distro_icon)

// SHELL Module

VARIABLE(shell, error, ShellModule::error)
